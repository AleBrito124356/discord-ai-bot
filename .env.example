# Copy this file to .env and fill in the values. .env is gitignored.

# --- Discord ---------------------------------------------------------------
# Discord Developer Portal -> Applications -> your app -> Bot -> Reset Token.
# A real token is three base64 chunks separated by dots. This is a fake sample.
DISCORD_BOT_TOKEN=MTIz.FAKE.this_is_a_placeholder_replace_with_your_real_token

# Comma-separated server (guild) IDs the bot may run in.
# Leave empty to allow every server it is invited to. When set, slash commands
# sync to those guilds instantly instead of the ~1 hour global rollout.
# Enable Developer Mode in Discord, right-click a server -> Copy Server ID.
ALLOWED_GUILD_IDS=

# --- NVIDIA NIM ------------------------------------------------------------
# Free API key from https://build.nvidia.com -> profile -> API Keys.
# It starts with "nvapi-". The signup takes about two minutes.
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional model overrides (defaults shown).
NIM_MODEL=meta/llama-3.3-70b-instruct
NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Optional endpoint override (default is NVIDIA's hosted NIM).
# Set it to "offline" (or BOT_OFFLINE=1) to run without any key on the
# deterministic offline backend.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
BOT_OFFLINE=

# --- Runtime tuning (all optional) -----------------------------------------
# Where the SQLite DB and RAG vector stores live. Default: ./data
DATA_DIR=

# Minimum seconds between two commands from the same user.
COOLDOWN_SECONDS=5

# Max commands per user per rolling 60 seconds.
RATE_LIMIT_PER_MINUTE=12

# Max tokens per LLM response.
NIM_MAX_TOKENS=900

# Minimum cosine similarity for a docs chunk to be used by /docs ask.
# Empty = backend default (0.2 with NIM, 0.05 offline).
RAG_MIN_SCORE=

# Images are converted/downscaled to fit these before going to the vision
# model. 180000 base64 chars is the inline limit in NVIDIA's hosted examples.
NIM_IMAGE_MAX_SIDE=1568
NIM_IMAGE_MAX_B64=180000
